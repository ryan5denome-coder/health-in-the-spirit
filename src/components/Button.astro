---
type Variant = 'primary' | 'secondary' | 'gold' | 'ghost' | 'cream';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: Variant;
  size?: Size;
  fullWidth?: boolean;
  external?: boolean;
  arrow?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  external = false,
  arrow = false,
  class: extraClass = '',
  ariaLabel,
} = Astro.props;

// Variants — terracotta primary, forest secondary outline, gold filled, ghost text-only, cream-on-dark
const variantClasses: Record<Variant, string> = {
  primary:
    'bg-accent text-accent-ink hover:bg-accent-hover border-2 border-accent hover:border-accent-hover',
  secondary:
    'bg-transparent text-heading hover:bg-surface-inverse hover:text-ink-inverse border-2 border-heading',
  gold:
    'bg-gold-500 text-heading hover:bg-gold-600 active:bg-gold-700 border-2 border-gold-500 hover:border-gold-600',
  ghost:
    'bg-transparent text-heading hover:text-accent border-2 border-transparent',
  cream:
    'bg-surface-raised text-heading hover:bg-surface-sunken border-2 border-surface-raised',
};

const sizeClasses: Record<Size, string> = {
  sm: 'text-xs px-4 py-2',
  md: 'text-sm px-5 py-2.5',
  lg: 'text-base px-7 py-3.5',
};

const baseClasses = [
  'inline-flex items-center justify-center gap-2',
  'font-semibold uppercase tracking-[0.12em]',
  'rounded-xl group transition-[color,background-color,border-color,transform,box-shadow] duration-200 ease-out',
  'motion-safe:hover:-translate-y-px active:translate-y-0',
  variant !== 'ghost' ? 'hover:shadow-[0_4px_14px_-6px_rgba(45,59,45,0.4)] active:shadow-none' : '',
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt',
  fullWidth ? 'w-full' : '',
  variantClasses[variant],
  sizeClasses[size],
  extraClass,
].filter(Boolean).join(' ');

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
{href ? (
  <a href={href} class={baseClasses} aria-label={ariaLabel} {...externalAttrs}>
    <slot />
    {arrow && <span aria-hidden="true" class="transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5 motion-safe:group-focus-visible:translate-x-0.5">→</span>}
  </a>
) : (
  <button type={type} class={baseClasses} aria-label={ariaLabel}>
    <slot />
    {arrow && <span aria-hidden="true" class="transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5 motion-safe:group-focus-visible:translate-x-0.5">→</span>}
  </button>
)}
