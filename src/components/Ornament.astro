---
// Gold divider ornament: hairline — diamond — hairline.
// Pure markup, decorative only. Pass a class for margin control.
const { class: extraClass = 'mt-6' } = Astro.props;
---
<div class:list={['flex items-center justify-center gap-3', extraClass]} aria-hidden="true">
  <span class="h-px w-10 sm:w-14 bg-gold-500/60"></span>
  <span class="h-1.5 w-1.5 rotate-45 bg-gold-500"></span>
  <span class="h-px w-10 sm:w-14 bg-gold-500/60"></span>
</div>
