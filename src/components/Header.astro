---
import { Icon } from 'astro-icon/components';

// Four content tabs plus Community. The Saints moved out of the top level:
// they are texture on this show, not the subject of it, so they live inside
// Resources and keep their own URLs.
const navItems = [
  { label: 'About',     href: '/about' },
  { label: 'Episodes',  href: '/episodes' },
  { label: 'Resources', href: '/resources' },
  { label: 'Blog',      href: '/blog' },
  { label: 'Community', href: '/community' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

{/* Frosted, not opaque: content scrolling under the header is part of what
    makes a page feel native rather than like a document. */}
<header class="material-chrome border-b border-line sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 sm:h-20 items-center justify-between gap-4">
      <a href="/" class="flex items-center shrink-0 rounded-md" aria-label="Health in the Spirit home">
        <img
          src="/brand/main-logo.svg"
          alt="Health in the Spirit"
          width="308"
          height="100"
          class="logo-light h-11 sm:h-14 w-auto"
        />
        <img
          src="/brand/main-logo-dark.svg"
          alt=""
          aria-hidden="true"
          width="308"
          height="100"
          class="logo-dark h-11 sm:h-14 w-auto"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-7" aria-label="Primary">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link text-sm font-medium tracking-wide uppercase whitespace-nowrap transition-colors',
              isActive(item.href) ? 'text-accent' : 'text-heading hover:text-accent',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="theme-toggle"
          class="w-10 h-10 grid place-items-center rounded-full text-heading
                 hover:bg-surface-sunken transition-colors
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt"
          aria-label="Switch between light and dark"
        >
          <Icon name="ph:sun-bold" class="w-5 h-5 hidden" data-icon-sun aria-hidden="true" />
          <Icon name="ph:moon-stars-bold" class="w-5 h-5 hidden" data-icon-moon aria-hidden="true" />
        </button>

        <a
          href="/listen"
          class="hidden sm:inline-flex items-center gap-2 rounded-xl
                 bg-accent hover:bg-accent-hover text-accent-ink
                 font-semibold uppercase tracking-wider text-sm px-5 py-2.5
                 transition-[background-color,transform] duration-200
                 motion-safe:hover:-translate-y-px active:translate-y-0
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt"
        >
          Listen
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="lg:hidden w-10 h-10 grid place-items-center rounded-full text-heading
                 hover:bg-surface-sunken transition-colors
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <Icon name="ph:list-bold" class="w-6 h-6" data-icon-open aria-hidden="true" />
          <Icon name="ph:x-bold" class="w-6 h-6 hidden" data-icon-close aria-hidden="true" />
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="lg:hidden hidden pb-4 safe-b">
      <nav class="flex flex-col gap-1" aria-label="Mobile primary">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block px-3 py-3 rounded-xl text-base font-medium uppercase tracking-wide transition-colors',
              isActive(item.href)
                ? 'text-accent bg-surface-sunken'
                : 'text-heading hover:bg-surface-sunken',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        href="/listen"
        class="mt-3 flex w-full items-center justify-center rounded-xl
               bg-accent hover:bg-accent-hover text-accent-ink
               font-semibold uppercase tracking-wider text-sm px-5 py-3.5 transition-colors"
      >
        Listen
      </a>
    </div>
  </div>
</header>

<script>
  // ── Mobile menu ──────────────────────────────────────────────────────────
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  toggle?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? true));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setMenu(false);
      toggle?.focus();
    }
  });

  // ── Theme toggle ─────────────────────────────────────────────────────────
  // Three states: no stored preference (follow the system), explicit light,
  // explicit dark. The button always offers the opposite of what is showing.
  const themeBtn = document.getElementById('theme-toggle');
  const sun = themeBtn?.querySelector('[data-icon-sun]');
  const moon = themeBtn?.querySelector('[data-icon-moon]');

  const systemDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = () => {
    const stored = document.documentElement.dataset.theme;
    return stored ? stored === 'dark' : systemDark();
  };

  const paintIcon = () => {
    const dark = isDark();
    // Showing dark, so offer the sun.
    sun?.classList.toggle('hidden', !dark);
    moon?.classList.toggle('hidden', dark);
    themeBtn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
  };

  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('hits-theme', next);
    } catch {
      // Private mode or blocked storage: the choice still applies to this page.
    }
    paintIcon();
  });

  // Track the system preference while no explicit choice is stored.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!document.documentElement.dataset.theme) paintIcon();
    });

  paintIcon();
</script>
