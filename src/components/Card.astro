---
type Variant = 'cream' | 'sage' | 'forest' | 'outline';

interface Props {
  href?: string;
  title: string;
  eyebrow?: string;
  description?: string;
  imageSrc?: string;
  imageAlt?: string;
  variant?: Variant;
  ctaLabel?: string;
  external?: boolean;
}

const {
  href,
  title,
  eyebrow,
  description,
  imageSrc,
  imageAlt = '',
  variant = 'cream',
  ctaLabel,
  external = false,
} = Astro.props;

const variantClasses: Record<Variant, string> = {
  cream:   'bg-surface-raised border border-line text-ink',
  sage:    'bg-surface-sunken border border-line text-ink',
  forest:  'bg-surface-inverse border border-line-strong text-ink-inverse',
  outline: 'bg-transparent border-2 border-heading/20 text-ink',
};

const isLinked = Boolean(href);
const Tag = (isLinked ? 'a' : 'div') as 'a' | 'div';
const externalAttrs = isLinked && external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const interactiveClasses = isLinked
  ? 'transition-all duration-200 hover:-translate-y-1 hover:shadow-md focus-visible:-translate-y-1 focus-visible:shadow-md'
  : '';
---
<Tag
  href={href}
  class={`group flex flex-col rounded-2xl overflow-hidden ${variantClasses[variant]} ${interactiveClasses}`}
  {...externalAttrs}
>
  {imageSrc && (
    <div class="aspect-[4/3] overflow-hidden bg-surface-sunken">
      <img src={imageSrc} alt={imageAlt} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
    </div>
  )}

  <div class="flex flex-col gap-3 p-6 sm:p-7 flex-1">
    {eyebrow && (
      <p class={`text-xs uppercase tracking-[0.2em] font-semibold ${variant === 'forest' ? 'text-gold-500' : 'text-gilt'}`}>
        {eyebrow}
      </p>
    )}

    <h3 class={`font-serif text-2xl leading-tight font-semibold ${variant === 'forest' ? 'text-ink-inverse' : 'text-heading'}`}>
      {title}
    </h3>

    {description && (
      <p class={`text-base leading-relaxed ${variant === 'forest' ? 'text-ink-inverse/85/90' : 'text-ink'}`}>
        {description}
      </p>
    )}

    <slot />

    {ctaLabel && (
      <p class={`mt-2 text-sm font-semibold uppercase tracking-[0.15em] inline-flex items-center gap-1 ${variant === 'forest' ? 'text-gold-500' : 'text-accent'}`}>
        {ctaLabel} <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </p>
    )}
  </div>
</Tag>
