---
/**
 * Email capture. The one conversion surface on the site.
 *
 * Provider-agnostic: it POSTs to `site.newsletter.formAction`, which is a plain
 * HTML form action so no JavaScript is required for it to work. MailerLite,
 * Kit, and Beehiiv all accept a same-shaped POST with an `email` field, so
 * switching providers is a one-line change in site.json.
 *
 * Until a real endpoint is configured, `newsletterLive` is false and we render
 * a mailto fallback instead of a form. A form that silently drops addresses is
 * worse than no form: the visitor believes they subscribed.
 */
import { site, newsletterLive } from '../lib/site';
import { Icon } from 'astro-icon/components';

type Tone = 'surface' | 'inverse';

interface Props {
  heading?: string;
  subheading?: string;
  /** Shown under the field. Defaults to the cadence promise from site.json. */
  note?: string;
  cta?: string;
  /** `inverse` for placement on a dark section. */
  tone?: Tone;
  /** Passed through as a hidden field so signups can be attributed. */
  source?: string;
  class?: string;
}

const {
  heading,
  subheading,
  note = site.newsletter.cadence,
  cta = 'Send it to me',
  tone = 'surface',
  source = 'site',
  class: extraClass = '',
} = Astro.props;

const inverse = tone === 'inverse';

// Contrast is what goes wrong on inverted forms, so every tone declares its own
// colors rather than inheriting. Note that `surface-inverse` flips with the
// theme: it is dark forest in light mode and pale sage in dark mode. So the
// inverse tone cannot hardcode cream text. It uses the inverse ink token, and
// the field itself uses the *normal* surface, which is always the opposite of
// whatever surface-inverse currently is. That holds in both themes.
const fieldClass = inverse
  ? 'bg-surface text-ink placeholder:text-ink-subtle border-transparent'
  : 'bg-surface-raised text-ink placeholder:text-ink-subtle border-line';

const labelClass = inverse ? 'text-ink-inverse' : 'text-ink';
const noteClass = inverse ? 'text-ink-inverse/80' : 'text-ink-subtle';
const headingClass = inverse ? 'text-ink-inverse' : 'text-heading';
const subClass = inverse ? 'text-ink-inverse/85' : 'text-ink-muted';
---

<div class={`w-full ${extraClass}`}>
  {heading && (
    <h2 class={`font-serif text-3xl sm:text-4xl leading-tight ${headingClass}`}>{heading}</h2>
  )}
  {subheading && (
    <p class={`mt-3 text-lg leading-relaxed ${subClass}`}>{subheading}</p>
  )}

  {newsletterLive ? (
    <form
      action={site.newsletter.formAction}
      method="post"
      class="mt-6"
      data-newsletter
      data-source={source}
    >
      {/* Label sits above the input. Never placeholder-as-label. */}
      <label for={`nl-email-${source}`} class={`block text-sm font-medium mb-2 ${labelClass}`}>
        Email address
      </label>

      <div class="flex flex-col sm:flex-row gap-3">
        <input
          id={`nl-email-${source}`}
          type="email"
          name="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          class={`flex-1 min-w-0 px-4 py-3.5 rounded-xl border text-base ${fieldClass}
                  transition-shadow duration-200
                  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt`}
        />
        <input type="hidden" name="source" value={source} />
        {/* Honeypot. Bots fill it, humans never see it. */}
        <div class="absolute w-px h-px -m-px overflow-hidden" aria-hidden="true">
          <label>
            Leave this empty
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <button
          type="submit"
          class="shrink-0 inline-flex items-center justify-center gap-2 rounded-xl
                 bg-accent hover:bg-accent-hover text-accent-ink
                 font-semibold uppercase tracking-[0.12em] text-sm px-6 py-3.5
                 transition-[background-color,transform,box-shadow] duration-200
                 motion-safe:hover:-translate-y-px active:translate-y-0
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt"
        >
          <span data-newsletter-label>{cta}</span>
          <Icon name="ph:arrow-right-bold" class="w-4 h-4 shrink-0" aria-hidden="true" />
        </button>
      </div>

      <p class={`mt-3 text-sm ${noteClass}`}>{note}</p>
      <p
        class="mt-3 text-sm font-medium hidden"
        data-newsletter-error
        role="alert"
      ></p>
    </form>
  ) : (
    /* No endpoint configured yet. Say so rather than pretending to collect. */
    <div class="mt-6">
      <a
        href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Add me to the list')}`}
        class="inline-flex items-center justify-center gap-2 rounded-xl
               bg-accent hover:bg-accent-hover text-accent-ink
               font-semibold uppercase tracking-[0.12em] text-sm px-6 py-3.5
               transition-[background-color,transform] duration-200
               motion-safe:hover:-translate-y-px active:translate-y-0
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gilt"
      >
        Email us to join
        <Icon name="ph:arrow-right-bold" class="w-4 h-4 shrink-0" aria-hidden="true" />
      </a>
      <p class={`mt-3 text-sm ${noteClass}`}>
        The signup form goes live as soon as the list is connected. Until then this reaches us directly.
      </p>
    </div>
  )}
</div>

<script>
  // Progressive enhancement only. Without JS the form still submits normally to
  // the provider and the visitor lands on the provider's own thank-you page.
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const button = form.querySelector('button[type="submit"]');
    const label = form.querySelector<HTMLElement>('[data-newsletter-label]');
    const error = form.querySelector<HTMLElement>('[data-newsletter-error]');
    const original = label?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      // Let the browser handle its own validation message first.
      if (!form.checkValidity()) return;

      event.preventDefault();
      error?.classList.add('hidden');
      button?.setAttribute('disabled', 'true');
      if (label) label.textContent = 'Sending';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));

        form.innerHTML = `
          <p class="text-lg font-serif" role="status">
            You are in. Check your inbox to confirm, then look for the first email.
          </p>`;
      } catch {
        // Fall back to a real navigation rather than losing the address: some
        // providers reject cross-origin fetch but accept a normal form post.
        button?.removeAttribute('disabled');
        if (label) label.textContent = original;
        if (error) {
          error.textContent = 'That did not go through. Press again and we will send you to the signup page.';
          error.classList.remove('hidden');
        }
        form.removeAttribute('data-newsletter');
      }
    });
  });
</script>
