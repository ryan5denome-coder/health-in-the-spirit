---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';

const page = await getEntry('pages', 'faq');
const faqs = page?.data.faqs ?? [];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="FAQ | Health in the Spirit"
  description="Frequently asked questions about Health in the Spirit, a Christian health and wellness podcast. Release schedule, where to listen, guest pitches, and seeing Dr. Ryan."
  jsonLd={faqJsonLd}
  breadcrumbs={[{ name: 'FAQ', url: '/faq' }]}
>

  <SectionContainer variant="cream" padding="large">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-heading leading-tight">
        Frequently asked questions
      </h1>
      <p class="mt-6 text-xl text-ink italic font-serif">
        Straight answers about the show, guesting, and seeing Dr. Ryan.
      </p>
    </div>
  </SectionContainer>

  <SectionContainer variant="cream" padding="default">
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((f) => (
        <details class="group bg-surface-raised border border-line hover:border-line-strong transition-colors rounded-2xl p-6 sm:p-7 [&_summary::-webkit-details-marker]:hidden">
          <summary class="cursor-pointer flex items-start justify-between gap-4 list-none">
            <h2 class="font-serif text-xl sm:text-2xl text-heading leading-tight">{f.q}</h2>
            <Icon
              name="ph:plus-bold"
              class="w-5 h-5 shrink-0 mt-1 text-gilt transition-transform duration-200 motion-reduce:transition-none group-open:rotate-45"
              aria-hidden="true"
            />
          </summary>
          <p class="mt-5 pt-4 border-t border-line text-base text-ink leading-relaxed max-w-[68ch]">{f.a}</p>
        </details>
      ))}
    </div>
  </SectionContainer>

  <SectionContainer variant="cream" padding="compact">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-lg text-ink">Still stuck on something we did not cover?</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href="/contact" variant="primary" size="md" arrow>Ask us directly</Button>
        <Button href="/episodes" variant="secondary" size="md">Browse the episodes</Button>
      </div>
    </div>
  </SectionContainer>

</BaseLayout>
