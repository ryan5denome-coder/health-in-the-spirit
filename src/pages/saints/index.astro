---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import SaintCard from '../../components/SaintCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Ornament from '../../components/Ornament.astro';

const allSaints = (await getCollection('saints', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const page = await getEntry('pages', 'saints-index');
const heroTitle = page?.data.heroTitle || 'The Healing Saints Who Guide Us';
const heroSubtitle =
  page?.data.heroSubtitle ||
  'Three witnesses across eighteen centuries. One unbroken Christian conviction that the body and the soul belong together.';
const moreSaintsNote =
  page?.data.moreSaintsNote ||
  'As the show grows, so will this collection. Saint Luke the Beloved Physician, Saint Raphael the Archangel, Saint Padre Pio, Saint Charbel Makhlouf, Saint Gianna Beretta Molla, and more. Each one a different facet of the same truth.';

// The saints now live under Resources in the site structure, but they keep
// their own URLs. The breadcrumb reflects the new parent; the paths do not move.
const crumbs = [
  { name: 'Resources', url: '/resources' },
  { name: 'The Saints', url: '/saints' },
];
---
<BaseLayout
  title="The Healing Saints Who Guide Us | Health in the Spirit"
  description="Profiles of the healing saints who shape Health in the Spirit: Cosmas and Damian, Hildegard of Bingen, and Augustine of Hippo, on caring for body and soul together."
  breadcrumbs={crumbs}
  keywords={['healing saints', 'Cosmas and Damian', 'Hildegard of Bingen', 'Augustine of Hippo', 'faith and health']}
>

  <SectionContainer variant="cream" padding="compact">
    <div class="max-w-3xl mx-auto">
      <Breadcrumbs items={crumbs} />
    </div>
  </SectionContainer>

  <SectionContainer variant="cream" padding="large">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-heading leading-tight">
        {heroTitle}
      </h1>
      <p class="mt-6 text-xl text-ink italic font-serif">
        {heroSubtitle}
      </p>
      <Ornament class="mt-6" />
    </div>
  </SectionContainer>

  <SectionContainer variant="sage" padding="default" id="patrons">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {allSaints.map((s) => (
        <SaintCard
          name={s.data.name}
          href={`/saints/${s.data.slug}`}
          role={s.data.role}
          era={s.data.era}
          summary={s.data.summary}
          imageSrc={s.data.iconImage}
          imageAlt={s.data.iconAlt}
        />
      ))}
    </div>
  </SectionContainer>

  <SectionContainer variant="cream" padding="default">
    <div class="max-w-3xl mx-auto text-center">
      <Ornament class="mb-8" />
      <h2 class="font-serif text-3xl sm:text-4xl text-heading leading-tight">More to come</h2>
      <p class="mt-4 text-lg text-ink">
        {moreSaintsNote}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/resources" variant="secondary" size="md">Back to resources</Button>
        <Button href="/episodes" variant="ghost" size="md">Listen to the show</Button>
      </div>
    </div>
  </SectionContainer>

</BaseLayout>
