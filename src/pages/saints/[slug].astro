---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import Prose from '../../components/Prose.astro';
import Button from '../../components/Button.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE_URL } from '../../lib/schema';

export async function getStaticPaths() {
  const all = await getCollection('saints', ({ data }) => !data.draft);
  return all.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const s = entry.data;

const augustineMottoBlock = s.slug === 'augustine-of-hippo';
const pageUrl = `${SITE_URL}/saints/${s.slug}`;

// Saints sit under Resources in the site structure now. The URL is unchanged.
const crumbs = [
  { name: 'Resources', url: '/resources' },
  { name: 'The Saints', url: '/saints' },
  { name: s.name, url: `/saints/${s.slug}` },
];

// ProfilePage + Person schema describing the saint as a historical entity.
// LLMs reading the page can confidently answer "Who is St. Hildegard?" and
// cite this profile as a source. Person fields use schema.org's standard
// vocabulary so they map cleanly to knowledge graphs.
const saintJsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${pageUrl}#page`,
    url: pageUrl,
    name: `${s.name}: Profile`,
    description: s.summary,
    inLanguage: 'en-US',
    isPartOf: { '@id': `${SITE_URL}#website` },
    mainEntity: {
      '@type': 'Person',
      '@id': `${pageUrl}#person`,
      name: s.name,
      description: s.summary,
      jobTitle: s.role,
      knowsAbout: ['Christian theology', 'Healing', 'Spirituality', 'Holistic health'],
      ...(s.iconImage ? { image: `${SITE_URL}${s.iconImage}` } : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: `${s.name}: a Health in the Spirit saint profile`,
    description: s.summary,
    author: { '@id': `${SITE_URL}/about#ryan` },
    publisher: { '@id': `${SITE_URL}#organization` },
    image: s.iconImage ? `${SITE_URL}${s.iconImage}` : `${SITE_URL}/og-default.png`,
    inLanguage: 'en-US',
    about: { '@id': `${pageUrl}#person` },
    mainEntityOfPage: pageUrl,
  },
];
---
<BaseLayout
  title={`${s.name} | Health in the Spirit`}
  description={s.summary || `A profile of ${s.name}, ${s.role}, on Health in the Spirit.`}
  ogImage={s.iconImage}
  ogImageWidth={1000}
  ogImageHeight={1000}
  ogType="article"
  jsonLd={saintJsonLd}
  breadcrumbs={crumbs}
  keywords={[s.name, s.role, 'healing saints', 'faith and health', 'Health in the Spirit', s.era]}
>

  <SectionContainer variant="cream" padding="compact">
    <div class="max-w-4xl mx-auto">
      <Breadcrumbs items={crumbs} />
    </div>
  </SectionContainer>

  <SectionContainer variant="cream" padding="large">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 items-center">
      <div class="md:col-span-2 flex justify-center">
        {s.iconImage ? (
          <div class="aspect-square w-48 sm:w-64 rounded-full overflow-hidden border border-line-strong ring-1 ring-line ring-offset-[5px] ring-offset-surface shadow-md">
            <img src={s.iconImage} alt={s.iconAlt || s.name} class="w-full h-full object-cover" />
          </div>
        ) : (
          <div class="aspect-square w-48 sm:w-64 rounded-full border border-line-strong ring-1 ring-line ring-offset-[5px] ring-offset-surface bg-surface-sunken flex items-center justify-center">
            <span class="font-serif text-7xl text-gilt italic">{s.name[0]}</span>
          </div>
        )}
      </div>
      <div class="md:col-span-3 text-center md:text-left">
        <h1 class="font-serif text-4xl sm:text-5xl text-heading leading-tight">
          {s.name}
        </h1>
        <p class="mt-3 text-ink-muted italic font-serif text-lg">{s.era} · {s.role}</p>
        {s.heroQuote && (
          <p class="mt-6 text-xl text-ink italic font-serif">
            "{s.heroQuote}"
          </p>
        )}
      </div>
    </div>
  </SectionContainer>

  <SectionContainer variant="cream" padding="default" id="profile">
    <div class="max-w-3xl mx-auto">
      <Prose dropCap>
        <Content />
      </Prose>
      {s.feastDay && (
        <aside class="mt-12 border-y border-line py-6 text-center">
          <p class="text-xs uppercase tracking-[0.25em] text-ink-subtle font-semibold">Feast Day</p>
          <p class="mt-2 font-serif text-2xl sm:text-3xl text-heading">{s.feastDay}</p>
        </aside>
      )}
    </div>
  </SectionContainer>

  {s.quotes && s.quotes.length > 0 && (
    <SectionContainer variant="sage" padding="default" id="quotes">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-serif text-3xl sm:text-4xl text-heading text-center mb-12 leading-tight">
          {s.quotes.some((q) => q.modern)
            ? 'Their wisdom, in the words of the tradition'
            : `${s.name.replace(/^Sts?\.\s*/, '').split(' ')[0]}, in their own words`}
        </h2>

        <div class={s.quotes.some((q) => q.modern) ? 'space-y-10' : 'space-y-8'}>
          {s.quotes.map((q) => (
            q.modern ? (
              <article class="bg-surface-raised border border-line rounded-2xl p-7 sm:p-9">
                <p class="font-serif text-xl sm:text-2xl text-heading italic leading-snug">
                  {q.text}
                </p>
                {q.citation && <p class="mt-3 text-sm text-ink-subtle italic">{q.citation}</p>}
                <p class="mt-6 text-xs text-accent font-semibold uppercase tracking-[0.15em]">In modern words</p>
                <p class="mt-2 text-lg text-ink">{q.modern}</p>
              </article>
            ) : (
              <figure class="bg-surface-raised border border-line border-l-4 border-l-accent p-7 sm:p-9 rounded-2xl">
                <p class="font-serif text-xl sm:text-2xl text-heading italic leading-snug">
                  {q.text}
                </p>
                {q.theme && (
                  <figcaption class="mt-4 text-xs uppercase tracking-[0.18em] text-ink-subtle font-semibold">{q.theme}</figcaption>
                )}
              </figure>
            )
          ))}
        </div>
      </div>
    </SectionContainer>
  )}

  {augustineMottoBlock && (
    <SectionContainer variant="forest" padding="default">
      <div class="max-w-3xl mx-auto rounded-2xl border border-ink-inverse/30 px-6 py-10 sm:px-12 text-center">
        <p class="font-serif text-2xl sm:text-3xl lg:text-4xl text-ink-inverse italic leading-tight">
          "Take care of your body as if you were going to live forever, and take care of your soul as if you were going to die tomorrow."
        </p>
        <p class="mt-6 text-sm text-ink-inverse/70 italic">Traditionally attributed to St. Augustine of Hippo. It is also our motto.</p>
      </div>
    </SectionContainer>
  )}

  <SectionContainer variant="cream" padding="default">
    <div class="max-w-2xl mx-auto text-center flex flex-wrap justify-center gap-3">
      <Button href="/saints" variant="secondary" size="md">All saints</Button>
      <Button href="/resources" variant="ghost" size="md">Back to resources</Button>
    </div>
  </SectionContainer>

</BaseLayout>
