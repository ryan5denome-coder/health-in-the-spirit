---
import { getCollection, getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionContainer from '../components/SectionContainer.astro';
import SaintCard from '../components/SaintCard.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import { site } from '../lib/site';

const home = await getEntry('pages', 'home');

const announcement = home?.data.announcementMessage
  ? {
      message: home.data.announcementMessage,
      ctaLabel: home.data.announcementCtaLabel,
      ctaHref: home.data.announcementCtaHref,
    }
  : undefined;

// Episodes, newest first. Sorted by date rather than number because two
// episodes share number 3 in the Transistor feed.
const episodes = (await getCollection('episodes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf(),
);
const [latest, ...rest] = episodes;
const recent = rest.slice(0, 3);
const episodeCount = episodes.length;

const saints = (await getCollection('saints', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({
    name: s.data.name,
    href: `/saints/${s.data.slug}`,
    role: s.data.role,
    era: s.data.era,
    summary: s.data.summary,
    imageSrc: s.data.iconImage,
    imageAlt: s.data.iconAlt,
  }));

const pillars = home?.data.pillars ?? [];

// Only platforms that actually exist. An empty string here means the show is
// not on that platform yet, and a dead link costs more trust than a missing one.
const platforms = [
  { name: 'Apple Podcasts', href: site.socialUrls.applePodcasts, icon: 'ph:apple-logo-fill' },
  { name: 'Spotify', href: site.socialUrls.spotify, icon: 'ph:spotify-logo-fill' },
  { name: 'RSS', href: site.socialUrls.rss, icon: 'ph:rss-simple-bold' },
].filter((p): p is { name: string; href: string; icon: string } => Boolean(p.href));
---

<BaseLayout
  title={`Health in the Spirit: ${site.tagline}`}
  description={site.defaultDescription}
  announcement={announcement}
>
  <Hero
    eyebrow={home?.data.heroEyebrow ?? site.tagline}
    title="Health in the Spirit"
    logoSrc="/brand/main-logo.svg"
    subtitle={home?.data.heroSubtitle}
    primaryCta={{
      label: home?.data.heroPrimaryCtaLabel ?? 'Listen now',
      href: home?.data.heroPrimaryCtaHref ?? '/episodes',
    }}
    secondaryCta={{
      label: home?.data.heroSecondaryCtaLabel ?? 'Meet the hosts',
      href: home?.data.heroSecondaryCtaHref ?? '/about',
    }}
    image={{
      src: '/photos/ryan-annie-formal.jpg',
      alt: 'Dr. Ryan and Annie DeNome, hosts of Health in the Spirit',
      width: 1400,
      height: 2100,
    }}
  />

  {/* ── Latest episode ──────────────────────────────────────────────────────
      Straight after the hero because it is the thing a first-time visitor
      came for. The newest episode gets the full feature treatment; the three
      behind it sit in a swipeable rail on phones and a grid on desktop. */}
  {latest && (
    <SectionContainer variant="cream" id="latest" reveal="none">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-8 sm:mb-10" data-reveal>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight">
          The latest episode
        </h2>
        <Button href="/episodes" variant="ghost" size="md" arrow>
          All {episodeCount} episodes
        </Button>
      </div>

      <div data-reveal>
        <EpisodeCard episode={latest.data} variant="feature" />
      </div>

      {recent.length > 0 && (
        <>
          {/* Rail on phones, grid from md up. Same markup, no duplication. */}
          <div
            class="mt-6 sm:mt-8 rail gap-4 -mx-4 px-4 sm:mx-0 sm:px-0
                   md:grid md:grid-cols-3 md:gap-6 md:overflow-visible"
            data-reveal-children
          >
            {recent.map((ep) => (
              <div class="w-[85vw] max-w-sm md:w-auto md:max-w-none">
                <EpisodeCard episode={ep.data} />
              </div>
            ))}
          </div>
        </>
      )}
    </SectionContainer>
  )}

  {/* ── What the show is about ──────────────────────────────────────────────
      Asymmetric: the lead pillar takes half the row, the other two split the
      rest. Hairline dividers rather than three matching boxes. */}
  {pillars.length > 0 && (
    <SectionContainer variant="sage" id="pillars" reveal="none">
      <div class="max-w-2xl mb-10 sm:mb-14" data-reveal>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight">
          Body and soul were never meant to be separate subjects.
        </h2>
        <p class="mt-4 text-lg text-ink-muted italic font-serif">
          Two thousand years of Christians have said so. Somewhere along the way we stopped listening.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12
               gap-y-8 md:gap-8 lg:gap-0
               divide-y md:divide-y-0 lg:divide-x divide-line"
        data-reveal-children
      >
        {pillars.map((p, i) => (
          <div
            class:list={[
              'flex flex-col gap-3 pt-8 md:pt-0 first:pt-0',
              // The lead pillar gets 5 of 12; the other two take 4 and 3, so the
              // row reads as a composition rather than three matching columns.
              i === 0 ? 'lg:col-span-5 lg:pr-10'
                : i === 1 ? 'lg:col-span-4 lg:px-8'
                : 'lg:col-span-3 lg:pl-8',
            ]}
          >
            <h3 class="font-serif text-2xl leading-tight font-semibold">{p.title}</h3>
            <p class="text-base leading-relaxed text-ink-muted">{p.description}</p>
            <a
              href={p.href}
              class="group mt-1 text-sm font-semibold uppercase tracking-[0.14em] text-accent
                     inline-flex items-center gap-1.5 self-start"
            >
              {p.cta}
              <Icon
                name="ph:arrow-right-bold"
                class="w-3.5 h-3.5 transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </a>
          </div>
        ))}
      </div>
    </SectionContainer>
  )}

  {/* ── The hosts ──────────────────────────────────────────────────────────── */}
  <SectionContainer variant="cream" id="hosts">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="aspect-square overflow-hidden rounded-2xl ring-1 ring-line">
        <img
          src="/photos/ryan-annie.jpg"
          alt="Dr. Ryan and Annie DeNome at home"
          class="w-full h-full object-cover"
          width="1400"
          height="1407"
          loading="lazy"
        />
      </div>
      <div class="flex flex-col gap-5">
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight">
          Dr. Ryan &amp; Annie DeNome
        </h2>
        <p class="text-lg text-ink-muted leading-relaxed measure">
          {home?.data.aboutTeaserBody}
        </p>
        {home?.data.aboutTeaserQuote && (
          <p class="text-lg text-ink leading-relaxed italic font-serif border-l-2 border-gilt pl-5">
            {home.data.aboutTeaserQuote}
          </p>
        )}
        <div class="mt-2">
          <Button href="/about" variant="secondary" size="md" arrow>Read our story</Button>
        </div>
      </div>
    </div>
  </SectionContainer>

  {/* ── Saints, as undertone ────────────────────────────────────────────────
      A quiet horizontal strip rather than a headline section. They inform the
      show; they are not the show. */}
  {saints.length > 0 && (
    <SectionContainer variant="sage" id="saints" reveal="none">
      <div class="max-w-2xl mb-10" data-reveal>
        <h2 class="font-serif text-3xl sm:text-4xl leading-tight">
          Physicians, herbalists, and one very stubborn abbess
        </h2>
        <Ornament class="mt-5" />
        <p class="mt-4 text-lg text-ink-muted leading-relaxed">
          Long before anyone said "holistic," Christians were treating the body as part of the soul's
          business. We keep their company on this show.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-children>
        {saints.map((s) => <SaintCard {...s} />)}
      </div>
    </SectionContainer>
  )}

  {/* ── Email capture ───────────────────────────────────────────────────────
      The one conversion goal on the page. Inverted so it reads as a stop. */}
  <SectionContainer variant="forest" id="newsletter">
    <div class="max-w-2xl mx-auto text-center">
      <NewsletterForm
        heading={home?.data.newsletterHeading ?? 'Get the show in your inbox.'}
        subheading={home?.data.newsletterSubtitle}
        tone="inverse"
        source="home"
        class="text-left"
      />
    </div>
  </SectionContainer>

  {/* ── Where to listen ─────────────────────────────────────────────────────── */}
  {platforms.length > 0 && (
    <SectionContainer variant="cream" id="platforms" padding="compact">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <h2 class="font-serif text-2xl sm:text-3xl leading-tight">
          Listen wherever you already listen
        </h2>
        <div class="flex flex-wrap gap-3">
          {platforms.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface-raised
                     px-4 py-3 text-sm font-semibold text-ink
                     transition-[border-color,transform] duration-200
                     hover:border-line-strong motion-safe:hover:-translate-y-px"
            >
              <Icon name={p.icon} class="w-5 h-5 text-accent" aria-hidden="true" />
              {p.name}
            </a>
          ))}
        </div>
      </div>
    </SectionContainer>
  )}
</BaseLayout>
