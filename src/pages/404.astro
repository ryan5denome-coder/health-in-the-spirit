---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';

// The newest published episode, so the most useful link on the page is never
// stale: it always points at whatever went out on the most recent Tuesday.
const latest = (await getCollection('episodes', ({ data }) => !data.draft && data.status === 'live'))
  .map((e) => e.data)
  .sort((a, b) => b.releaseDate.getTime() - a.releaseDate.getTime())[0];

const destinations = [
  { href: '/episodes', icon: 'ph:headphones-bold', title: 'Every episode', body: 'The full back catalog, newest first.' },
  { href: '/about', icon: 'ph:users-three-bold', title: 'About Ryan and Annie', body: 'A chiropractor and a theologian, and how this started.' },
  { href: '/resources', icon: 'ph:books-bold', title: 'Resources', body: 'What we recommend, plus the healing saints.' },
  { href: '/contact', icon: 'ph:envelope-simple-bold', title: 'Contact', body: 'Tell us what you were looking for.' },
];
---
<BaseLayout
  title="Page not found | Health in the Spirit"
  description="That page could not be found. Head to the episodes, the newest episode, or the homepage."
  noindex
>

  <SectionContainer variant="cream" padding="large">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-serif text-5xl sm:text-7xl text-heading leading-tight">
        Page not found
      </h1>
      <p class="mt-6 text-xl text-ink italic font-serif max-w-[46ch] mx-auto">
        "Even in a world that's being shipwrecked, remain brave and strong."
      </p>
      <p class="mt-2 text-sm text-ink-subtle italic">St. Hildegard of Bingen</p>

      <p class="mt-10 text-lg text-ink max-w-[60ch] mx-auto">
        The page you wanted either moved, never existed, or is still being written. Here is where most people are headed.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3 sm:gap-4">
        <Button href="/episodes" variant="primary" size="lg" arrow>Browse the episodes</Button>
        <Button href="/" variant="secondary" size="lg">Back to the homepage</Button>
      </div>
    </div>
  </SectionContainer>

  {latest && (
    <SectionContainer variant="sage" padding="default" id="latest-episode">
      <div class="max-w-3xl mx-auto">
        <a
          href={`/episodes/${latest.slug}`}
          class="group block bg-surface-raised border border-line rounded-2xl p-6 sm:p-8 hover:border-line-strong transition-colors"
        >
          <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle font-semibold">Newest episode</p>
          <h2 class="mt-3 font-serif text-2xl sm:text-3xl text-heading leading-tight group-hover:text-accent transition-colors">
            {latest.title}
          </h2>
          <p class="mt-3 text-base text-ink max-w-[68ch]">{latest.description}</p>
          <p class="mt-5 text-xs uppercase tracking-[0.15em] text-accent font-semibold inline-flex items-center gap-1.5">
            Listen to it
            <Icon
              name="ph:arrow-right-bold"
              class="w-3.5 h-3.5 transition-transform duration-200 motion-safe:group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </p>
        </a>
      </div>
    </SectionContainer>
  )}

  <SectionContainer variant="cream" padding="default">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {destinations.map((d) => (
        <a
          href={d.href}
          class="group bg-surface-raised border border-line rounded-2xl p-6 hover:border-line-strong motion-safe:hover:-translate-y-0.5 transition-all"
        >
          <Icon name={d.icon} class="w-6 h-6 text-gilt" aria-hidden="true" />
          <p class="mt-3 font-serif text-xl text-heading group-hover:text-accent transition-colors">{d.title}</p>
          <p class="mt-1 text-sm text-ink-muted">{d.body}</p>
        </a>
      ))}
    </div>
  </SectionContainer>

</BaseLayout>
